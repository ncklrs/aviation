[Unit]
Description=Overhead: log interesting aircraft to interesting.json
After=network-online.target readsb.service

[Service]
# Optional push alerts: set NTFY_TOPIC (and NTFY_SERVER / NTFY_TAGS) in this file. Missing file = no alerts.
EnvironmentFile=-/etc/default/interesting-logger
ExecStart=/usr/bin/python3 /usr/local/bin/interesting_logger.py --src http://127.0.0.1/tar1090/data/aircraft.json --out /usr/local/share/tar1090/html/ot/interesting.json
Restart=always
RestartSec=30
User=www-data
Nice=10

[Install]
WantedBy=multi-user.target
